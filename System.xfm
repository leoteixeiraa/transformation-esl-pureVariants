    <cm:element cm:id="ipkJsf_aWol39UA6t" cm:name="BaseClassVariation_1" cm:type="ps:feature" cm:class="ps:feature">
      <cm:relations cm:id="i7VIQ7ADlEouHVZjs" cm:class="ps:parents">
        <cm:relation cm:id="iWBax32HDoD3OY0Wf" cm:type="ps:parent">
          <cm:target cm:id="iI8EU9O4O5X2azOep">./i4Kw7VuhYUDwOdHl7</cm:target>
        </cm:relation>
      </cm:relations>
      <cm:vname>
        <cm:mimedesc cm:id="ik1XufFZ_QHFBN7GN" cm:mimetype="text/plain" cm:encoding="utf-8">ps:file: Use Alternative Header Implementation Variant2 for ClassB using ps:srcfile</cm:mimedesc>
      </cm:vname>
      <cm:desc>
        <cm:mimedesc cm:id="iYZFFqaEA5RP_bS0-" cm:mimetype="text/html" cm:encoding="utf-8">To provide different implementation files which shall have the same name during compilation
use the ps:srcfile attribute on a ps:file element and  different values e.g. "ClassB_Variant1.h" 
and "ClassB_Variant2.h". Select the values with appropriate restrictions.
See example for ClassB in System.ccfm. By default ClassB_Variant1.h is the selected implementation 
but if "Alternative Implementation for ClassB" is selected, ClassB_Variant2.h is selected and copied to 
ClassB.h 

</cm:mimedesc>
      </cm:desc>
    </cm:element>
