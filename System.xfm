      </cm:properties>
      <cm:vname>
        <cm:mimedesc cm:id="i6gbckqZlS7LRaFCe" cm:mimetype="text/plain" cm:encoding="utf-8">Viewing Product Information</cm:mimedesc>
      </cm:vname>
      <cm:desc>
        <cm:mimedesc cm:id="irMUcLUvAZJcnDzm7" cm:mimetype="text/html" cm:encoding="utf-8">&lt;ul&gt;
&lt;li&gt;Foco:&amp;nbsp;Informa&amp;ccedil;&amp;otilde;es do&amp;nbsp;produto em si&amp;nbsp;(dados comerciais/catalogr&amp;aacute;ficos)&lt;/li&gt;
&lt;li&gt;O que mostra:Contexto de uso:&amp;nbsp;Quando o usu&amp;aacute;rio quer&amp;nbsp;ver detalhes do produto cadastrado&amp;nbsp;no sistema, independente da ESL
&lt;ul&gt;
&lt;li&gt;Nome do produto&lt;/li&gt;
&lt;li&gt;GTIN (c&amp;oacute;digo de barras)&lt;/li&gt;
&lt;li&gt;Descri&amp;ccedil;&amp;atilde;o do produto&lt;/li&gt;
&lt;li&gt;Categoria&lt;/li&gt;
&lt;li&gt;Informa&amp;ccedil;&amp;otilde;es comerciais do produto no sistema&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
&lt;li&gt;&lt;/li&gt;
&lt;li&gt;Exemplo:&amp;nbsp;Ver ficha t&amp;eacute;cnica completa de um produto espec&amp;iacute;fico&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;</cm:mimedesc>
      </cm:desc>
    </cm:element>
    <cm:element cm:id="iMrir6P5O7FtFf5HA" cm:name="Displaying_ESL_Information" cm:type="ps:feature" cm:class="ps:feature">
