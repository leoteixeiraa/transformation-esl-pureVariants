        </cm:property>
      </cm:properties>
      <cm:vname>
        <cm:mimedesc cm:id="iURyU1M7Bs6uvL_eI" cm:mimetype="text/plain" cm:encoding="utf-8">Displaying ESL Information</cm:mimedesc>
      </cm:vname>
      <cm:desc>
        <cm:mimedesc cm:id="io03L46cDKT2vXBJQ" cm:mimetype="text/html" cm:encoding="utf-8">&lt;h3&gt;2.&amp;nbsp;Displaying_ESL_Information&amp;nbsp;&amp;#x1f3f7;&amp;#xfe0f;&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;Foco:&amp;nbsp;Informa&amp;ccedil;&amp;otilde;es da&amp;nbsp;etiqueta eletr&amp;ocirc;nica (hardware/device)&lt;/li&gt;
&lt;li&gt;O que mostra:
&lt;ul&gt;
&lt;li&gt;MAC Address da ESL&lt;/li&gt;
&lt;li&gt;Status da ESL (instalada, operacional, etc.)&lt;/li&gt;
&lt;li&gt;Status de comissionamento&lt;/li&gt;
&lt;li&gt;Battery level&lt;/li&gt;
&lt;li&gt;Template utilizado&lt;/li&gt;
&lt;li&gt;Qual produto est&amp;aacute; ASSOCIADO&amp;nbsp;&amp;agrave; ESL (refer&amp;ecirc;ncia)&lt;/li&gt;
&lt;li&gt;Renderiza&amp;ccedil;&amp;atilde;o atual da tela da ESL&lt;/li&gt;
&lt;li&gt;Hist&amp;oacute;rico de atualiza&amp;ccedil;&amp;otilde;es da etiqueta&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
&lt;li&gt;Contexto de uso:&amp;nbsp;Quando o usu&amp;aacute;rio quer&amp;nbsp;gerenciar/verificar o estado f&amp;iacute;sico da etiqueta&lt;/li&gt;
&lt;li&gt;Exemplo:&amp;nbsp;Verificar se a ESL est&amp;aacute; funcionando, seu n&amp;iacute;vel de bateria, e qual produto ela est&amp;aacute; exibindo&lt;/li&gt;
&lt;/ul&gt;</cm:mimedesc>
      </cm:desc>
    </cm:element>
