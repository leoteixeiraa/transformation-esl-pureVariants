        </cm:relation>
      </cm:relations>
      <cm:relations cm:id="i6mfaaSEKTLfMTHeJ" cm:class="ps:dependencies">
      </cm:relations>
      <cm:properties>
        <cm:property cm:id="iVW1sGdhGwki5EHQK" cm:type="ps:string" cm:fixed="true" cm:readonly="true" cm:name="ps:Source">
          <cm:constant cm:id="i-KueFPjFrvdQlyat" cm:type="ps:string">leove</cm:constant>
        </cm:property>
        <cm:property cm:id="ir4xCWSiXnUOEIwcX" cm:type="ps:datetime" cm:fixed="true" cm:readonly="true" cm:name="ps:Created">
          <cm:constant cm:id="ivgbBcQC8RU7W0uKS" cm:type="ps:datetime">2025-11-20T17:52:04.639Z</cm:constant>
        </cm:property>
        <cm:property cm:id="i_BZ5WxDnrO4_k5C3" cm:type="ps:string" cm:fixed="true" cm:readonly="true" cm:name="ps:ChangedBy">
          <cm:constant cm:id="iQRGzJTTfzzmshxcV" cm:type="ps:string">leove</cm:constant>
        </cm:property>
        <cm:property cm:id="itsJt0QDCJm9E4Qh7" cm:type="ps:datetime" cm:fixed="true" cm:readonly="true" cm:name="ps:Changed">
          <cm:constant cm:id="iH9jsKNj_8H_JOwiV" cm:type="ps:datetime">2025-11-21T03:54:20.901Z</cm:constant>
        </cm:property>
      </cm:properties>
      <cm:vname>
        <cm:mimedesc cm:id="inn6z2-XKNj19AwS_" cm:mimetype="text/plain" cm:encoding="utf-8">Installation</cm:mimedesc>
      </cm:vname>
      <cm:desc>
        <cm:mimedesc cm:id="iY6rsDEVttJsz_emK" cm:mimetype="text/html" cm:encoding="utf-8">&lt;h1 data-end="908" data-start="874"&gt;Por que &amp;eacute; Relation (requires)?&lt;/h1&gt;
&lt;p data-end="943" data-start="910"&gt;O manual descreve rela&amp;ccedil;&amp;otilde;es assim:&lt;/p&gt;
&lt;p data-end="949" data-start="945"&gt;&amp;#x1f4cc;&lt;/p&gt;
&lt;blockquote data-end="1046" data-start="950"&gt;
&lt;p data-end="1046" data-start="952"&gt;&amp;#x201c;Supported relations are: &lt;strong data-end="990" data-start="978"&gt;requires&lt;/strong&gt;, conflicts, recommends&amp;#x2026;&amp;#x201d;&lt;br data-end="1018" data-start="1015"&gt; &amp;#x3010;pv-user-manual.pdf&amp;#x2020;L33-L38&amp;#x3011;&lt;/p&gt;
&lt;/blockquote&gt;
&lt;p data-end="1052" data-start="1048"&gt;E:&lt;/p&gt;
&lt;blockquote data-end="1149" data-start="1053"&gt;
&lt;p data-end="1149" data-start="1055"&gt;&amp;#x201c;Relations are checked after restrictions and must be satisfied.&amp;#x201d;&lt;br data-end="1123" data-start="1120"&gt; &amp;#x3010;pv-user-manual.pdf&amp;#x2020;L7-L9&amp;#x3011;&lt;/p&gt;
&lt;/blockquote&gt;
&lt;p data-end="1159" data-start="1151"&gt;Ou seja:&lt;/p&gt;
&lt;h3 data-end="1212" data-start="1161"&gt;&amp;#x27a4; Relation = depend&amp;ecirc;ncia l&amp;oacute;gica entre features.&lt;/h3&gt;
&lt;p data-end="1236" data-start="1214"&gt;Exatamente o seu caso:&lt;/p&gt;
&lt;ul data-end="1379" data-start="1238"&gt;
&lt;li data-end="1379" data-start="1238"&gt;
&lt;p data-end="1379" data-start="1240"&gt;Installation &lt;strong data-end="1264" data-start="1253"&gt;depende&lt;/strong&gt; que Uninstallation tamb&amp;eacute;m esteja selecionado.&lt;br data-end="1313" data-start="1310"&gt; Isso &amp;eacute; um &lt;strong data-end="1335" data-start="1323"&gt;requires&lt;/strong&gt;, n&amp;atilde;o uma restri&amp;ccedil;&amp;atilde;o condicional de inclus&amp;atilde;o.&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;</cm:mimedesc>
      </cm:desc>
    </cm:element>
