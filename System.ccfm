    <cm:element cm:id="i7-SpXiN89QfXVSEJ" cm:name="Makefile" cm:type="ps:project" cm:class="ps:part" cm:default="on">
      <cm:relations cm:id="ivLXNS_56_jGyHWZe" cm:class="ps:parents">
