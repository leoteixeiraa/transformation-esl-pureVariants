      <cm:vname>
        <cm:mimedesc cm:id="iGRQ6YvdGkdZkYiLr" cm:mimetype="text/plain" cm:encoding="utf-8">commissioning_view</cm:mimedesc>
      </cm:vname>
      <cm:desc>
        <cm:mimedesc cm:id="iBXLqQ8xh_9-aPj5b" cm:mimetype="text/html" cm:encoding="utf-8">&lt;table&gt;
&lt;thead&gt;
&lt;tr&gt;&lt;th&gt;Atributo&lt;/th&gt;&lt;th&gt;Valor no seu modelo&lt;/th&gt;&lt;th&gt;Significado&lt;/th&gt;&lt;/tr&gt;
&lt;/thead&gt;
&lt;tbody&gt;
&lt;tr&gt;
&lt;td&gt;&lt;strong&gt;file&lt;/strong&gt;&lt;/td&gt;
&lt;td&gt;&lt;code&gt;'commissioning_process_manager.dart'&lt;/code&gt;&lt;/td&gt;
&lt;td&gt;Nome do arquivo real no sistema. O PV vai procurar esse arquivo f&amp;iacute;sico no diret&amp;oacute;rio indicado em &lt;code&gt;dir&lt;/code&gt;.&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;&lt;strong&gt;dir&lt;/strong&gt;&lt;/td&gt;
&lt;td&gt;&lt;code&gt;'src/sys'&lt;/code&gt;&lt;/td&gt;
&lt;td&gt;Caminho relativo dentro do projeto (&lt;code&gt;System/src/sys&lt;/code&gt;). &amp;Eacute; de onde o PV vai copiar o arquivo durante a transforma&amp;ccedil;&amp;atilde;o.&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;&lt;strong&gt;type&lt;/strong&gt;&lt;/td&gt;
&lt;td&gt;&lt;code&gt;'misc'&lt;/code&gt;&lt;/td&gt;
&lt;td&gt;Tipo do arquivo. &lt;code&gt;misc&lt;/code&gt; significa que o PV apenas vai &lt;strong&gt;copiar&lt;/strong&gt; o arquivo pro produto (sem processamento especial). Ideal para &lt;code&gt;.dart&lt;/code&gt;, &lt;code&gt;.json&lt;/code&gt;, &lt;code&gt;.yaml&lt;/code&gt;, etc.&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;&lt;strong&gt;srcdir&lt;/strong&gt;&lt;/td&gt;
&lt;td&gt;&lt;code&gt;'C:\purevariants_repo\Transformation ESL\System\src'&lt;/code&gt;&lt;/td&gt;
&lt;td&gt;Caminho f&amp;iacute;sico absoluto onde o PV encontra os arquivos-fonte originais. Esse valor &amp;eacute; gerado automaticamente.&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;</cm:mimedesc>
      </cm:desc>
    </cm:element>
