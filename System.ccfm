      <cm:desc>
        <cm:mimedesc cm:id="i83LUUEBuZc_0ANGe" cm:mimetype="text/html" cm:encoding="utf-8">&lt;table&gt;
&lt;tbody&gt;
&lt;tr&gt;
&lt;td data-col-size="sm" data-end="1011" data-start="982"&gt;&amp;nbsp;&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;table&gt;
&lt;tbody&gt;
&lt;tr&gt;
&lt;td data-col-size="md" data-end="1096" data-start="1011"&gt;
&lt;p&gt;ps: class = Uma &lt;strong data-end="1049" data-start="1017"&gt;unidade funcional do sistema&lt;/strong&gt;, aqui representando a &lt;em data-end="1095" data-start="1072"&gt;feature Commissioning.&lt;/em&gt;&lt;/p&gt;
&lt;p&gt;&lt;em&gt;O ps:Class &lt;/em&gt;Funciona como um &amp;#x201c;m&amp;oacute;dulo&amp;#x201d; no contexto do dom&amp;iacute;nio. Voc&amp;ecirc; pode imaginar como a &amp;#x201c;classe base&amp;#x201d; que agrupa todos os arquivos relacionados &amp;agrave; feature.&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;</cm:mimedesc>
      </cm:desc>
    </cm:element>
