      <cm:vname>
        <cm:mimedesc cm:id="ikOdBCIsChxpcCQ8_id838529" cm:mimetype="text/plain" cm:encoding="utf-8">System</cm:mimedesc>
      </cm:vname>
      <cm:desc>
        <cm:mimedesc cm:id="iYd1eftBTg7Ic5Gr1" cm:mimetype="text/html" cm:encoding="utf-8">&lt;p&gt;&lt;strong id="docs-internal-guid-5e722229-7fff-5938-da81-28d2a589b2fd" style="font-weight: normal;"&gt;&lt;span style="color: #000000; font-family: Arial,sans-serif; font-size: 10pt; font-style: normal; font-variant: normal; font-weight: 400; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: transparent;"&gt;O arquivo &lt;/span&gt;&lt;span style="color: #188038; font-family: 'Roboto Mono',monospace; font-size: 10pt; font-style: normal; font-variant: normal; font-weight: 400; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: transparent;"&gt;.ccfm&lt;/span&gt;&lt;span style="color: #000000; font-family: Arial,sans-serif; font-size: 10pt; font-style: normal; font-variant: normal; font-weight: 400; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: transparent;"&gt; (&lt;/span&gt;&lt;span style="color: #000000; font-family: Arial,sans-serif; font-size: 10pt; font-style: normal; font-variant: normal; font-weight: bold; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: transparent;"&gt;Component Family Model&lt;/span&gt;&lt;span style="color: #000000; font-family: Arial,sans-serif; font-size: 10pt; font-style: normal; font-variant: normal; font-weight: 400; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: transparent;"&gt;) define a &lt;/span&gt;&lt;span style="color: #000000; font-family: Arial,sans-serif; font-size: 10pt; font-style: normal; font-variant: normal; font-weight: bold; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: transparent;"&gt;fam&amp;iacute;lia de artefatos&lt;/span&gt;&lt;span style="color: #000000; font-family: Arial,sans-serif; font-size: 10pt; font-style: normal; font-variant: normal; font-weight: 400; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: transparent;"&gt; (arquivos, partes de c&amp;oacute;digo, configura&amp;ccedil;&amp;otilde;es, etc.)&lt;/span&gt;&lt;span style="color: #000000; font-family: Arial,sans-serif; font-size: 10pt; font-style: normal; font-variant: normal; font-weight: 400; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: transparent;"&gt;&lt;br&gt;&lt;/span&gt;&lt;span style="color: #000000; font-family: Arial,sans-serif; font-size: 10pt; font-style: normal; font-variant: normal; font-weight: 400; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: transparent;"&gt; que podem ser &lt;/span&gt;&lt;span style="color: #000000; font-family: Arial,sans-serif; font-size: 10pt; font-style: normal; font-variant: normal; font-weight: bold; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: transparent;"&gt;reutilizados e transformados&lt;/span&gt;&lt;span style="color: #000000; font-family: Arial,sans-serif; font-size: 10pt; font-style: normal; font-variant: normal; font-weight: 400; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: transparent;"&gt; para gerar diferentes variantes de um sistema.&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style="line-height: 1.38; margin-top: 12pt; margin-bottom: 12pt;" dir="ltr"&gt;&lt;strong id="docs-internal-guid-5e722229-7fff-5938-da81-28d2a589b2fd" style="font-weight: normal;"&gt;&lt;span style="color: #000000; font-family: Arial,sans-serif; font-size: 10pt; font-style: normal; font-variant: normal; font-weight: 400; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: transparent;"&gt;&amp;#x27a1;&amp;#xfe0f; Em outras palavras:&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style="margin: 12pt 30pt; line-height: 1.38;" dir="ltr"&gt;&lt;strong id="docs-internal-guid-5e722229-7fff-5938-da81-28d2a589b2fd" style="font-weight: normal;"&gt;&lt;span style="color: #000000; font-family: Arial,sans-serif; font-size: 10pt; font-style: normal; font-variant: normal; font-weight: 400; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: transparent;"&gt;&amp;Eacute; o modelo que &lt;/span&gt;&lt;span style="color: #000000; font-family: Arial,sans-serif; font-size: 10pt; font-style: normal; font-variant: normal; font-weight: bold; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: transparent;"&gt;representa os elementos do c&amp;oacute;digo-fonte que podem variar&lt;/span&gt;&lt;span style="color: #000000; font-family: Arial,sans-serif; font-size: 10pt; font-style: normal; font-variant: normal; font-weight: 400; text-decoration: none; vertical-align: baseline; white-space: pre-wrap; background-color: transparent;"&gt; entre produtos e que servir&amp;atilde;o de base para a transforma&amp;ccedil;&amp;atilde;o autom&amp;aacute;tica.&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;
&lt;p&gt;&amp;nbsp;&lt;/p&gt;</cm:mimedesc>
      </cm:desc>
    </cm:element>
