&lt;tbody&gt;
&lt;tr&gt;
&lt;td data-col-size="sm" data-end="1545" data-start="1511"&gt;&lt;strong data-end="1544" data-start="1513"&gt;Restriction (Commissioning)&lt;/strong&gt;&lt;/td&gt;
