        <cm:relation cm:id="iybFrdvn9se1f9-xl" cm:type="ps:parent">
          <cm:target cm:id="iaalOFsgkg6o4K8bm">./inK20tQGZCqaiaS5a</cm:target>
        </cm:relation>
      </cm:relations>
      <cm:properties>
        <cm:property cm:id="iDOBZpCCm1ovgQ-PX" cm:type="ps:path" cm:fixed="true" cm:name="file">
          <cm:constant cm:id="iafZp_yn9VJfOw_as" cm:type="ps:string">ClassB.h</cm:constant>
          <cm:desc>
            <cm:mimedesc cm:id="i6Gf0UT9JG0uSrIBu" cm:mimetype="text/html" cm:encoding="utf-8">&lt;ul data-end="514" data-start="129"&gt;
&lt;li data-end="211" data-start="129"&gt;
&lt;p data-end="211" data-start="131"&gt;O item &amp;eacute; um &lt;strong data-end="156" data-start="143"&gt;&lt;code data-end="154" data-start="145"&gt;ps:file&lt;/code&gt;&lt;/strong&gt; chamado &lt;strong data-end="179" data-start="165"&gt;&lt;code data-end="177" data-start="167"&gt;ClassB.h&lt;/code&gt;&lt;/strong&gt; (nome do &lt;strong data-end="209" data-start="189"&gt;arquivo de sa&amp;iacute;da&lt;/strong&gt;).&lt;/p&gt;
&lt;/li&gt;
&lt;li data-end="333" data-start="212"&gt;
&lt;p data-end="285" data-start="214"&gt;Em &lt;strong data-end="243" data-start="217"&gt;Attributes &amp;#x2192; &lt;code data-end="241" data-start="232"&gt;srcfile&lt;/code&gt;&lt;/strong&gt;, ele listou &lt;strong data-end="284" data-start="256"&gt;duas fontes alternativas&lt;/strong&gt;:&lt;/p&gt;
&lt;ul data-end="333" data-start="288"&gt;
&lt;li data-end="309" data-start="288"&gt;
&lt;p data-end="309" data-start="290"&gt;&lt;code data-end="309" data-start="290"&gt;ClassB_Variant1.h&lt;/code&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li data-end="333" data-start="312"&gt;
&lt;p data-end="333" data-start="314"&gt;&lt;code data-end="333" data-start="314"&gt;ClassB_Variant2.h&lt;/code&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
&lt;li data-end="514" data-start="334"&gt;
&lt;p data-end="432" data-start="336"&gt;Cada &lt;strong data-end="363" data-start="341"&gt;valor de &lt;code data-end="361" data-start="352"&gt;srcfile&lt;/code&gt;&lt;/strong&gt; recebe &lt;strong data-end="398" data-start="371"&gt;uma Restriction pr&amp;oacute;pria&lt;/strong&gt; (na aba &lt;em data-end="421" data-start="407"&gt;Restrictions&lt;/em&gt;), do tipo:&lt;/p&gt;
&lt;ul data-end="514" data-start="435"&gt;
&lt;li data-end="473" data-start="435"&gt;
&lt;p data-end="473" data-start="437"&gt;&lt;code data-end="447" data-start="437"&gt;Variant1&lt;/code&gt; &amp;#x2192; usa &lt;code data-end="473" data-start="454"&gt;ClassB_Variant1.h&lt;/code&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li data-end="514" data-start="476"&gt;
&lt;p data-end="514" data-start="478"&gt;&lt;code data-end="488" data-start="478"&gt;Variant2&lt;/code&gt; &amp;#x2192; usa &lt;code data-end="514" data-start="495"&gt;ClassB_Variant2.h&lt;/code&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;blockquote data-end="731" data-start="516"&gt;
&lt;p data-end="731" data-start="518"&gt;Resultado: o &lt;strong data-end="557" data-start="531"&gt;mesmo arquivo de sa&amp;iacute;da&lt;/strong&gt; (&lt;code data-end="569" data-start="559"&gt;ClassB.h&lt;/code&gt;) &amp;eacute; &lt;strong data-end="612" data-start="573"&gt;montado a partir de uma &amp;uacute;nica fonte&lt;/strong&gt; por vez, escolhida conforme a feature/vari&amp;aacute;vel ativa.&lt;br data-end="669" data-start="666"&gt; &amp;Eacute; um &amp;#x201c;&lt;strong data-end="699" data-start="677"&gt;ou isso, ou aquilo&lt;/strong&gt;&amp;#x201d; dentro do &lt;strong data-end="730" data-start="711"&gt;mesmo &lt;code data-end="728" data-start="719"&gt;ps:file&lt;/code&gt;&lt;/strong&gt;.&lt;/p&gt;
&lt;/blockquote&gt;
&lt;h3 data-end="774" data-start="733"&gt;Diferen&amp;ccedil;a para o que voc&amp;ecirc; vem fazendo&lt;/h3&gt;
&lt;ul data-end="1034" data-start="775"&gt;
&lt;li data-end="852" data-start="775"&gt;
&lt;p data-end="852" data-start="777"&gt;&lt;strong data-end="785" data-start="777"&gt;Voc&amp;ecirc;&lt;/strong&gt;: cria v&amp;aacute;rios &lt;code data-end="808" data-start="799"&gt;ps:file&lt;/code&gt; (um para cada &lt;code data-end="830" data-start="823"&gt;.dart&lt;/code&gt;) e restringe cada um.&lt;/p&gt;
&lt;/li&gt;
&lt;li data-end="1034" data-start="853"&gt;
&lt;p data-end="1034" data-start="855"&gt;&lt;strong data-end="866" data-start="855"&gt;Exemplo&lt;/strong&gt;: &lt;strong data-end="883" data-start="868"&gt;1 &lt;code data-end="881" data-start="872"&gt;ps:file&lt;/code&gt;&lt;/strong&gt; com &lt;strong data-end="917" data-start="888"&gt;v&amp;aacute;rias fontes (&lt;code data-end="914" data-start="905"&gt;srcfile&lt;/code&gt;)&lt;/strong&gt;, cada fonte com sua &lt;strong data-end="951" data-start="938"&gt;restri&amp;ccedil;&amp;atilde;o&lt;/strong&gt; &amp;#x2192; sempre gera &lt;strong data-end="992" data-start="966"&gt;um &amp;uacute;nico nome de sa&amp;iacute;da&lt;/strong&gt;, mas com &lt;strong data-end="1033" data-start="1002"&gt;implementa&amp;ccedil;&amp;otilde;es alternativas&lt;/strong&gt;.&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;h3 data-end="1066" data-start="1036"&gt;Quando usar cada abordagem&lt;/h3&gt;
&lt;ul data-end="1494" data-start="1067"&gt;
&lt;li data-end="1254" data-start="1067"&gt;
&lt;p data-end="1254" data-start="1069"&gt;&lt;strong data-end="1101" data-start="1069"&gt;V&amp;aacute;rios &lt;code data-end="1087" data-start="1078"&gt;ps:file&lt;/code&gt; (seu jeito)&lt;/strong&gt;: quando os &lt;strong data-end="1155" data-start="1113"&gt;arquivos de sa&amp;iacute;da t&amp;ecirc;m nomes diferentes&lt;/strong&gt; (ex.: &lt;code data-end="1198" data-start="1162"&gt;commissioning_process_manager.dart&lt;/code&gt;, &lt;code data-end="1234" data-start="1200"&gt;step1_decommission_macInput.dart&lt;/code&gt;). &amp;Eacute; o mais simples.&lt;/p&gt;
&lt;/li&gt;
&lt;li data-end="1494" data-start="1255"&gt;
&lt;p data-end="1494" data-start="1257"&gt;&lt;strong data-end="1294" data-start="1257"&gt;Um &lt;code data-end="1271" data-start="1262"&gt;ps:file&lt;/code&gt; com v&amp;aacute;rios &lt;code data-end="1292" data-start="1283"&gt;srcfile&lt;/code&gt;&lt;/strong&gt;: quando voc&amp;ecirc; quer &lt;strong data-end="1335" data-start="1313"&gt;o mesmo nome final&lt;/strong&gt; (ex.: &lt;code data-end="1368" data-start="1342"&gt;commissioning_step1.dart&lt;/code&gt;) por&amp;eacute;m com &lt;strong data-end="1409" data-start="1380"&gt;implementa&amp;ccedil;&amp;otilde;es diferentes&lt;/strong&gt; (ex.: &lt;code data-end="1448" data-start="1416"&gt;commissioning_step1_implA.dart&lt;/code&gt; e &lt;code data-end="1467" data-start="1451"&gt;..._implB.dart&lt;/code&gt;) selecionadas por feature.&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;h3 data-end="1535" data-start="1496"&gt;Como reproduzir isso no seu Flutter&lt;/h3&gt;
&lt;p data-end="1635" data-start="1536"&gt;Suponha que voc&amp;ecirc; quer sempre gerar &lt;code data-end="1597" data-start="1571"&gt;commissioning_step1.dart&lt;/code&gt;, mas escolher a implementa&amp;ccedil;&amp;atilde;o A ou B:&lt;/p&gt;
&lt;ol data-end="1662" data-start="1637"&gt;
&lt;li data-end="1662" data-start="1637"&gt;
&lt;p data-end="1662" data-start="1640"&gt;Crie &lt;strong data-end="1651" data-start="1645"&gt;um&lt;/strong&gt; &lt;code data-end="1661" data-start="1652"&gt;ps:file&lt;/code&gt;:&lt;/p&gt;
&lt;/li&gt;
&lt;/ol&gt;
&lt;ul data-end="1736" data-start="1663"&gt;
&lt;li data-end="1700" data-start="1663"&gt;
&lt;p data-end="1700" data-start="1665"&gt;&lt;code data-end="1698" data-start="1665"&gt;file = commissioning_step1.dart&lt;/code&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li data-end="1720" data-start="1701"&gt;
&lt;p data-end="1720" data-start="1703"&gt;&lt;code data-end="1718" data-start="1703"&gt;dir = src/sys&lt;/code&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li data-end="1736" data-start="1721"&gt;
&lt;p data-end="1736" data-start="1723"&gt;&lt;code data-end="1736" data-start="1723"&gt;type = misc&lt;/code&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;ol start="2" data-end="1797" data-start="1738"&gt;
&lt;li data-end="1797" data-start="1738"&gt;
&lt;p data-end="1797" data-start="1741"&gt;Em &lt;strong data-end="1770" data-start="1744"&gt;Attributes &amp;#x2192; &lt;code data-end="1768" data-start="1759"&gt;srcfile&lt;/code&gt;&lt;/strong&gt;, adicione &lt;strong data-end="1796" data-start="1781"&gt;duas linhas&lt;/strong&gt;:&lt;/p&gt;
&lt;/li&gt;
&lt;/ol&gt;
&lt;ul data-end="1867" data-start="1798"&gt;
&lt;li data-end="1832" data-start="1798"&gt;
&lt;p data-end="1832" data-start="1800"&gt;&lt;code data-end="1832" data-start="1800"&gt;commissioning_step1_implA.dart&lt;/code&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li data-end="1867" data-start="1833"&gt;
&lt;p data-end="1867" data-start="1835"&gt;&lt;code data-end="1867" data-start="1835"&gt;commissioning_step1_implB.dart&lt;/code&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;ol start="3" data-end="1938" data-start="1869"&gt;
&lt;li data-end="1938" data-start="1869"&gt;
&lt;p data-end="1938" data-start="1872"&gt;Para cada linha de &lt;code data-end="1900" data-start="1891"&gt;srcfile&lt;/code&gt;, v&amp;aacute; &amp;agrave; aba &lt;strong data-end="1927" data-start="1911"&gt;Restrictions&lt;/strong&gt; e coloque:&lt;/p&gt;
&lt;/li&gt;
&lt;/ol&gt;
&lt;ul data-end="2020" data-start="1939"&gt;
&lt;li data-end="1979" data-start="1939"&gt;
&lt;p data-end="1979" data-start="1941"&gt;para a 1&amp;ordf;: &lt;code data-end="1979" data-start="1952"&gt;Commissioning &amp;amp;&amp;amp; VariantA&lt;/code&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;li data-end="2020" data-start="1980"&gt;
&lt;p data-end="2020" data-start="1982"&gt;para a 2&amp;ordf;: &lt;code data-end="2020" data-start="1993"&gt;Commissioning &amp;amp;&amp;amp; VariantB&lt;/code&gt;&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;blockquote data-end="2145" data-start="2022"&gt;
&lt;p data-end="2145" data-start="2024"&gt;Assim, o output ter&amp;aacute; &lt;strong data-end="2055" data-start="2045"&gt;sempre&lt;/strong&gt; &lt;code data-end="2082" data-start="2056"&gt;commissioning_step1.dart&lt;/code&gt;, mas o conte&amp;uacute;do vem da fonte A &lt;strong data-end="2120" data-start="2114"&gt;ou&lt;/strong&gt; B, conforme as features.&lt;/p&gt;
&lt;/blockquote&gt;
&lt;h3 data-end="2189" data-start="2147"&gt;O que significam os campos da sua tela&lt;/h3&gt;
&lt;ul data-end="2582" data-start="2190"&gt;
&lt;li data-end="2263" data-start="2190"&gt;
&lt;p data-end="2263" data-start="2192"&gt;&lt;strong data-end="2214" data-start="2192"&gt;dir (ps:directory)&lt;/strong&gt;: caminho &lt;strong data-end="2236" data-start="2224"&gt;de sa&amp;iacute;da&lt;/strong&gt; relativo (ex.: &lt;code data-end="2261" data-start="2252"&gt;src/sys&lt;/code&gt;).&lt;/p&gt;
&lt;/li&gt;
&lt;li data-end="2322" data-start="2264"&gt;
&lt;p data-end="2322" data-start="2266"&gt;&lt;strong data-end="2284" data-start="2266"&gt;file (ps:path)&lt;/strong&gt;: &lt;strong data-end="2312" data-start="2286"&gt;nome do arquivo gerado&lt;/strong&gt; (output).&lt;/p&gt;
&lt;/li&gt;
&lt;li data-end="2400" data-start="2323"&gt;
&lt;p data-end="2400" data-start="2325"&gt;&lt;strong data-end="2347" data-start="2325"&gt;type (ps:filetype)&lt;/strong&gt;: comportamento; para Dart use &lt;strong data-end="2388" data-start="2378"&gt;&lt;code data-end="2386" data-start="2380"&gt;misc&lt;/code&gt;&lt;/strong&gt; (s&amp;oacute; copia).&lt;/p&gt;
&lt;/li&gt;
&lt;li data-end="2472" data-start="2401"&gt;
&lt;p data-end="2472" data-start="2403"&gt;&lt;strong data-end="2428" data-start="2403"&gt;srcdir (ps:directory)&lt;/strong&gt;: base &lt;strong data-end="2448" data-start="2435"&gt;de origem&lt;/strong&gt; (onde est&amp;atilde;o os fontes).&lt;/p&gt;
&lt;/li&gt;
&lt;li data-end="2582" data-start="2473"&gt;
&lt;p data-end="2582" data-start="2475"&gt;&lt;strong data-end="2496" data-start="2475"&gt;srcfile (ps:path)&lt;/strong&gt;: &lt;strong data-end="2521" data-start="2498"&gt;fontes alternativas&lt;/strong&gt; do mesmo &lt;code data-end="2540" data-start="2531"&gt;ps:file&lt;/code&gt;. Cada valor pode ter sua &lt;strong data-end="2581" data-start="2566"&gt;Restriction&lt;/strong&gt;.&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p data-end="2763" data-start="2584" data-is-only-node="" data-is-last-node=""&gt;Se quiser, eu te monto um mini bloco com esse &lt;code data-end="2639" data-start="2630"&gt;ps:file&lt;/code&gt; &amp;#x201c;um nome / m&amp;uacute;ltiplas fontes&amp;#x201d; pronto pra colar no &lt;code data-end="2696" data-start="2689"&gt;.ccfm&lt;/code&gt; (com &lt;code data-end="2712" data-start="2702"&gt;VariantA&lt;/code&gt;/&lt;code data-end="2723" data-start="2713"&gt;VariantB&lt;/code&gt;) usando suas features de Commissioning.&lt;/p&gt;</cm:mimedesc>
          </cm:desc>
        </cm:property>
        <cm:property cm:id="it9ZNh7dTMBFy1rR8" cm:type="ps:filetype" cm:fixed="true" cm:name="type">
          <cm:constant cm:id="iiw3CPB7Ot7ng3m36" cm:type="ps:string">def</cm:constant>
        </cm:property>
        <cm:property cm:id="iVSxqqokWg7fzxlpJ" cm:type="ps:directory" cm:fixed="true" cm:name="srcdir">
          <cm:constant cm:id="ig0-EADikYNpSfk6J" cm:type="ps:string">src</cm:constant>
        </cm:property>
        <cm:property cm:id="i-w5qSyNyzvFcuIS1" cm:type="ps:path" cm:fixed="true" cm:name="srcfile">
          <cm:constant cm:id="igGppzfU2IlpRRqHi" cm:restriction="ikfvKDghOCsN_4tZl" cm:type="ps:string">ClassB_Variant2.h</cm:constant>
